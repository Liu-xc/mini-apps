<?xml version="1.0" encoding="utf-8"?>
<!-- 拾彩图标：墨底上两颗交叠的摇奖球（玩法红 + 特号蓝），球面留高光；
     monochrome 同源（themed icon 已接线）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:pivotX="54"
        android:pivotY="54">
        <!-- 红球（主区） -->
        <path
            android:fillColor="#D84B40"
            android:pathData="M40,54 a18,18 0 1 0 36,0 a18,18 0 1 0 -36,0 z" />
        <!-- 蓝球（特号区），叠在红球右下 -->
        <path
            android:fillColor="#3A6FD8"
            android:pathData="M54,60 a15,15 0 1 0 30,0 a15,15 0 1 0 -30,0 z" />
        <!-- 红球高光 -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.35"
            android:pathData="M46,46 a5,4 0 1 0 10,0 a5,4 0 1 0 -10,0 z" />
        <!-- 蓝球高光 -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.35"
            android:pathData="M60,63 a4,3.5 0 1 0 8,0 a4,3.5 0 1 0 -8,0 z" />
    </group>
</vector>
